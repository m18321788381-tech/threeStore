# 开发环境：热重载，代码通过 bind mount 挂载
# 构建加速参数同 Dockerfile：APT_MIRROR_HOST / APT_BUILD_DEPS / PIP_INDEX_URL
FROM python:3.12-slim

ARG APT_MIRROR_HOST=mirrors.cloud.tencent.com
ARG APT_BUILD_DEPS=curl
ARG PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_INDEX_URL=${PIP_INDEX_URL}

# 依赖都有预编译 wheel，默认只装 curl；需要加新依赖再 --build-arg "APT_BUILD_DEPS=build-essential libpq-dev curl"
RUN set -eux; \
    if [ -n "$APT_BUILD_DEPS" ]; then \
        sed -i "s|deb.debian.org|$APT_MIRROR_HOST|g; s|security.debian.org|$APT_MIRROR_HOST|g" \
            /etc/apt/sources.list /etc/apt/sources.list.d/* || true; \
        apt-get update; \
        apt-get install -y --no-install-recommends $APT_BUILD_DEPS; \
        rm -rf /var/lib/apt/lists/*; \
    fi

WORKDIR /app
COPY requirements.txt .
RUN pip install -r requirements.txt

EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
