# ============================================================
# 个人博客 · 环境变量示例（复制为 .env 后按部署环境修改）
# 详细说明见 README.md
#
#  ⚠️  安全基线（APP_ENV=production 时后端会在启动时强制校验，不合规直接拒绝启动）：
#    1. SECRET_KEY / JWT_SECRET 必须是 `openssl rand -hex 32` 生成的高熵随机值，且互不相同
#    2. ADMIN_PASSWORD 必须 ≥ 12 位强口令，严禁使用 admin12345 等默认口令
#    3. SITE_URL 必须是真实访问地址，不能是 localhost（否则 RSS/Sitemap/OG 全部失效）
#   曾因沿用本文件的默认凭据直接上生产，导致后台可被任意接管，请勿重蹈覆辙。
# ============================================================

# ---------- 部署环境 ----------
APP_ENV=production                 # development | production | test
DEBUG=false
LOG_LEVEL=INFO

# ---------- 站点信息（RSS / Sitemap / 动态 OG 卡片） ----------
# 生产必须改成真实地址，例如 https://your-domain.com（末尾不要带斜杠）
SITE_URL=https://your-domain.com
SITE_TITLE=三石笔记
SITE_DESCRIPTION=一个内容驱动的个人技术博客
SITE_AUTHOR=博主
SITE_LOCALE=zh-CN

# ---------- 安全密钥（生产必改！留空会导致生产模式启动失败） ----------
# 生成方式：openssl rand -hex 32
SECRET_KEY=
JWT_SECRET=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE=30            # 分钟
REFRESH_TOKEN_EXPIRE=720          # 分钟

# ---------- 登录防爆破 ----------
LOGIN_FAIL_LIMIT=5                # 同一 IP 窗口内允许的失败次数
LOGIN_FAIL_WINDOW=900             # 秒（15 分钟）
LOGIN_LOCK_SECONDS=900            # 触发后的锁定时长（秒）
LOGIN_FAIL_LIMIT_PER_ACCOUNT=5    # 同一 IP + 账号维度
LOGIN_GLOBAL_LIMIT=30             # 同一 IP 窗口内总尝试次数（成功+失败）
LOGIN_GLOBAL_WINDOW=900           # 秒

# ---------- PostgreSQL ----------
DB_HOST=db
DB_PORT=5432
DB_USER=blog
DB_PASSWORD=blog
DB_NAME=blog
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---------- 媒体上传 ----------
MEDIA_ROOT=/app/media
MEDIA_URL=/media
MAX_UPLOAD_MB=10
# SVG 是 XML，可内嵌 <script> 造成存储型 XSS，默认关闭。
# 开启后系统会强制 XML 净化（剔除脚本 / 事件属性 / 外部引用）。
ALLOW_SVG_UPLOAD=false

# ---------- CORS / 前端地址 ----------
FRONTEND_URL=https://your-domain.com
CORS_ORIGINS=https://your-domain.com

# ---------- 反垃圾评论 ----------
COMMENT_MIN_LEN=2
COMMENT_MAX_LEN=2000
COMMENT_RATE_LIMIT=10             # 同一 IP 窗口内最多 N 条
COMMENT_RATE_WINDOW=600           # 秒
COMMENT_MAX_LINKS=2
COMMENT_SENSITIVE_WORDS=

# ---------- Redis（可选；留空则限流降级为内存实现、SEO 缓存按需生成） ----------
# 启用 docker-compose.redis.yml 时设为 redis://redis:6379/0
# 多副本部署时务必配置，否则登录锁定与评论限流各副本各算各的。
REDIS_URL=
# worker 周期刷新 SEO 缓存间隔（秒）与缓存 TTL（秒）
WORKER_REFRESH_INTERVAL=300
SEO_CACHE_TTL=3600

# ---------- 分页 ----------
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=50

# ---------- 管理员引导账号（首次启动自动创建） ----------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
# 生产必改：≥12 位强口令。留空或保留默认值会导致生产模式启动失败。
ADMIN_PASSWORD=
ADMIN_DISPLAY_NAME=博主

# ---------- Docker 编排专用 ----------
# 对外暴露端口（宿主机）与 Postgres 数据卷名
# POSTGRES_DATA 必须是合法的 Docker 命名卷名（不要写成宿主机路径）
COMPOSE_PROJECT_NAME=blog
HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_DATA=blog_pgdata

# ---------- 备份（make backup） ----------
# 备份文件存放目录（宿主机路径）；保留天数
BACKUP_DIR=./backups
BACKUP_KEEP_DAYS=14

# ---------- 构建加速（国内云主机直连官方源会卡住，按需修改） ----------
# apt / apk 源主机名；腾讯云 CVM 可改为内网源 mirrors.tencentyun.com（免公网流量）
APT_MIRROR_HOST=mirrors.cloud.tencent.com
APK_MIRROR_HOST=mirrors.cloud.tencent.com
# pip / npm 索引地址
PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple
NPM_REGISTRY=https://mirrors.cloud.tencent.com/npm/
# 依赖均有预编译 wheel，后端构建默认不装编译器；若某依赖报缺 gcc/libpq 再取消注释
# APT_BUILD_DEPS=build-essential libpq-dev
# APT_RUNTIME_DEPS=libpq5 curl

# 生产用：开启 TLS 时把 Nginx 指到证书目录（见 nginx/ssl.conf.example）
# SSL_CERT_PATH=./nginx/certs/fullchain.pem
# SSL_KEY_PATH=./nginx/certs/privkey.pem
# 启用 HTTPS 后，记得在 nginx 配置中补上下面的 HSTS 响应头：
#   add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
