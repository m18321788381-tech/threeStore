# ============================================================
# 个人博客 · 环境变量示例（复制为 .env 后按部署环境修改）
# 详细说明见 README.md
# ============================================================

# ---------- 部署环境 ----------
APP_ENV=production                 # development | production | test
DEBUG=false
LOG_LEVEL=INFO

# ---------- 站点信息（RSS / Sitemap / 动态 OG 卡片） ----------
SITE_URL=http://localhost
SITE_TITLE=三石笔记
SITE_DESCRIPTION=一个内容驱动的个人技术博客
SITE_AUTHOR=博主
SITE_LOCALE=zh-CN

# ---------- 安全密钥（生产务必修改！） ----------
SECRET_KEY=change-me-in-production
JWT_SECRET=change-me-jwt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE=30            # 分钟
REFRESH_TOKEN_EXPIRE=720          # 分钟

# ---------- PostgreSQL ----------
DB_HOST=db
DB_PORT=5432
DB_USER=blog
DB_PASSWORD=blog
DB_NAME=blog
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ---------- 媒体上传 ----------
MEDIA_ROOT=/app/media
MEDIA_URL=/media
MAX_UPLOAD_MB=10

# ---------- CORS / 前端地址 ----------
FRONTEND_URL=http://localhost
CORS_ORIGINS=http://localhost

# ---------- 反垃圾评论 ----------
COMMENT_MIN_LEN=2
COMMENT_MAX_LEN=2000
COMMENT_RATE_LIMIT=3
COMMENT_RATE_WINDOW=300
COMMENT_MAX_LINKS=2
COMMENT_SENSITIVE_WORDS=

# ---------- Redis（可选；留空则禁用 worker / SEO 缓存） ----------
# 启用 docker-compose.redis.yml 时设为 redis://redis:6379/0
REDIS_URL=
# worker 周期刷新 SEO 缓存间隔（秒）与缓存 TTL（秒）
WORKER_REFRESH_INTERVAL=300
SEO_CACHE_TTL=3600

# ---------- 分页 ----------
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=50

# ---------- 管理员引导账号（首次启动自动创建，可改） ----------
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin12345
ADMIN_DISPLAY_NAME=博主

# ---------- Docker 编排专用 ----------
# 对外暴露端口（宿主机）与 Postgres 数据卷名
COMPOSE_PROJECT_NAME=blog
HTTP_PORT=80
HTTPS_PORT=443
POSTGRES_DATA=blog_pgdata

# 生产用：开启 TLS 时把 Nginx 指到证书目录（见 nginx/ssl.conf.example）
# SSL_CERT_PATH=./nginx/certs/fullchain.pem
# SSL_KEY_PATH=./nginx/certs/privkey.pem
